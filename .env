# Copy to ".env" and edit. Restart the server after any change.

# Port the system listens on (choose any free port)
PORT=2100
#SSL_PFX_FILE=cert.pfx
#SSL_PFX_PASSPHRASE=12341234
# Interface to listen on: 0.0.0.0 = reachable from the network, 127.0.0.1 = this machine only
HOST=0.0.0.0

# Where the database lives (back this folder up)
DATA_DIR=./data

# Set to true when users reach the site over HTTPS (recommended for production)
COOKIE_SECURE=auto
# Login session length in hours
SESSION_HOURS=8
# Number of reverse proxies in front of the app (1 if behind Nginx / a load balancer)
TRUST_PROXY=1

# Optional: fixed secret for login tokens (long random string). Needed if you run several instances.
# If empty, one is generated automatically and stored in DATA_DIR/.secret
JWT_SECRET=
